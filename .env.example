# Static Savvy Media Environment Configuration

# ---------------------------------------------------------------------------
# SMTP — used by netlify/functions/submit-contact.js to email the admin
#    Works with any SMTP provider (Zoho Mail, Gmail app password, Brevo,
#    SendGrid SMTP relay, Amazon SES SMTP, etc.)
# ---------------------------------------------------------------------------

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# "true" only if SMTP_PORT is 465 (implicit SSL). Leave "false" for 587 (STARTTLS).
SMTP_SECURE=false
SMTP_USER=your-smtp-username@example.com
SMTP_PASS=PASTE_SMTP_PASSWORD_OR_APP_PASSWORD_HERE

# From header shown to the admin. MAIL_FROM often matches SMTP_USER —
# some providers reject a From address that isn't the authenticated mailbox.
MAIL_FROM=your-smtp-username@example.com
MAIL_FROM_NAME=Static Savvy Media Website

# Where enquiry emails are delivered
ADMIN_EMAIL=admin@staticsavvymedia.com

# ---------------------------------------------------------------------------
# Google reCAPTCHA v2 ("I'm not a robot" checkbox) — used on every contact
#    form across the site. Get keys at https://www.google.com/recaptcha/admin
# ---------------------------------------------------------------------------

# Public site key — safe to expose in the browser bundle. Must be prefixed
# with VITE_ so Vite injects it into client code.
VITE_RECAPTCHA_SITE_KEY=PASTE_RECAPTCHA_SITE_KEY_HERE

# Private secret key — used only server-side in netlify/functions/submit-contact.js.
# Never prefix this with VITE_ (that would leak it to the browser).
RECAPTCHA_SECRET_KEY=PASTE_RECAPTCHA_SECRET_KEY_HERE

# ---------------------------------------------------------------------------
# Analytics / Tag Manager — public IDs, safe to commit.
# ---------------------------------------------------------------------------
VITE_GTM_ID=GTM-TT9MF95
VITE_CLARITY_ID=ybukc0fqtr

# Optional: canonical site origin used for canonicals/og:url. Leave unset (defaults to
# https://www.staticsavvymedia.com). If set, it must be the www origin.
# VITE_SITE_URL=https://www.staticsavvymedia.com
