# Static Savvy Media Environment Configuration
# Register your site domain at: https://www.google.com/recaptcha/admin

# 1. Frontend Site Key (Public - exposed to browser bundle)
# Configure in Netlify Site Configuration -> Environment Variables as VITE_RECAPTCHA_SITE_KEY
VITE_RECAPTCHA_SITE_KEY=PASTE_SITE_KEY_HERE

# 2. Backend Secret Key (Private - SERVER-SIDE ONLY, NEVER expose to client)
# Configure in Netlify Site Configuration -> Environment Variables as RECAPTCHA_SECRET_KEY
RECAPTCHA_SECRET_KEY=PASTE_SECRET_KEY_HERE
